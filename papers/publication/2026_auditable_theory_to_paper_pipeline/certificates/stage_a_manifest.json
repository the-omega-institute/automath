{
  "schema_version": "stage-a-submitted-manifest-v1",
  "purpose": "Submitted finite Stage-A replay manifest for the CICM presentation route; executable acceptance is conditional on ScanOK, RecordGateOK, CertDAGOK, DigestOKstage_a, and ScriptOKstage_a.",
  "path_normalization": {
    "relative_paths_only": true,
    "forward_slashes_only": true,
    "reject_dot_dot_segments": true,
    "sort_key": [
      "role",
      "path",
      "atom"
    ]
  },
  "artifact_bundle": [
    {
      "role": "manifest",
      "path": "certificates/stage_a_manifest.json"
    },
    {
      "role": "horn_schema",
      "path": "certificates/stage_a_horn_schema.json"
    },
    {
      "role": "replay_certificate",
      "path": "certificates/stage_a_horn_audit_certificate.json"
    },
    {
      "role": "replay_report",
      "path": "certificates/stage_a_replay_report.json"
    },
    {
      "role": "digest_table",
      "path": "certificates/stage_a_digest_table.json"
    },
    {
      "role": "replay_script",
      "path": "certificates/replay_stage_a_audit.py"
    }
  ],
  "compiler_rows": [
    {
      "atom": "pubAbs",
      "sort": "public_surface",
      "path": "submission_abstract.tex"
    },
    {
      "atom": "suppMain",
      "sort": "supplement_surface",
      "path": "main.tex"
    },
    {
      "atom": "invJson",
      "sort": "inventory_row",
      "path": "theorem_inventory.json"
    },
    {
      "atom": "invMd",
      "sort": "inventory_row",
      "path": "theorem_inventory.md"
    },
    {
      "atom": "finalDigest",
      "sort": "digest_row",
      "path": "certificates/stage_a_digest_table.json"
    },
    {
      "atom": "mainTex",
      "sort": "source_bytes",
      "path": "main.tex"
    },
    {
      "atom": "stageAHornSchema",
      "sort": "schema_file",
      "path": "certificates/stage_a_horn_schema.json"
    },
    {
      "atom": "stageAManifest",
      "sort": "support_surface",
      "path": "certificates/stage_a_manifest.json"
    },
    {
      "atom": "stageAHornCertificate",
      "sort": "certificate_file",
      "path": "certificates/stage_a_horn_audit_certificate.json"
    },
    {
      "atom": "stageAReplayReport",
      "sort": "report_file",
      "path": "certificates/stage_a_replay_report.json"
    },
    {
      "atom": "RecordGateOK",
      "sort": "finite_predicate",
      "predicate": "RecordGateOK(stage_a_manifest, stage_a_horn_schema, stage_a_replay_report)"
    },
    {
      "atom": "CertDAGOK",
      "sort": "finite_predicate",
      "predicate": "CertDAGOK(stage_a_horn_audit_certificate, stage_a_horn_schema)"
    },
    {
      "atom": "DigestOKstage_a",
      "sort": "digest_row",
      "path": "certificates/stage_a_digest_table.json"
    },
    {
      "atom": "srcInterface",
      "sort": "source_interface_row",
      "path": "source_interface_record.json"
    },
    {
      "atom": "caseArtifacts",
      "sort": "artifact_row",
      "path": "review_bundle/case_snapshots/"
    },
    {
      "atom": "venueReadiness",
      "sort": "venue_row",
      "path": "review_bundle/VENUE_BIBLIOGRAPHY_LIVE_CHECK_2026-06-13.md"
    },
    {
      "atom": "stableLocator",
      "sort": "replay_identity_row",
      "coordinate": "locatorOKstageA",
      "boundary": "stable public or venue-controlled locator for the submitted replay archive"
    },
    {
      "atom": "archiveByteEquality",
      "sort": "replay_identity_row",
      "coordinate": "locatorOKstageA",
      "boundary": "byte equality between the locator target and the submitted archive rows"
    },
    {
      "atom": "qrgsReplayUpgrade",
      "sort": "upgrade_coordinate",
      "coordinate": "qrgs",
      "bounded_to": "fixed Stage-A Horn schema, canonical manifest, replay certificate, replay report, digest table"
    }
  ],
  "conditional_premise_rows": [
    {
      "atom": "scanOK",
      "sort": "finite_predicate",
      "branch": "A_scan_and_A_plus",
      "predicate": "ScanOK(mainTexBytes, invJsonBytes, invMdBytes, digestTable)",
      "not_emitted_by": "compiler_rows"
    },
    {
      "atom": "ScriptOKstage_a",
      "sort": "tcb_assumption",
      "branch": "A_plus_only",
      "path": "certificates/replay_stage_a_audit.py",
      "not_emitted_by": "compiler_rows"
    }
  ],
  "coordinate_scope": {
    "qraw": "positive-local-inventory-byte-closure",
    "qrgs": "positive-fixed-stage-a-replay-only",
    "qsrc": "negative-no-fresh-formal-source-upgrade",
    "qart": "negative-no-dynamic-artifact-semantic-upgrade",
    "qext": "negative-no-external-archive-equivalence-upgrade",
    "qven": "negative-no-upload-time-venue-acceptance-upgrade"
  },
  "negative_boundaries": [
    "no fresh Lean/BEDC rebuild",
    "no axiom-purity audit",
    "no dynamic artifact-semantic validation",
    "no external archive equivalence promotion row",
    "no upload-time venue compliance",
    "no venue acceptance",
    "no general pipeline implementation soundness"
  ]
}
