{
  "schema_name": "finite_publication_certificate_record",
  "schema_version": "2026-06-03.a2-round1",
  "route": "CICM presentation-only / mathematical software workshop",
  "description": "Executable schema for the finite certificate verifier V in the technical supplement. The schema is deliberately first-order: the verifier checks field presence, finite gate coverage, evidence pointers, evidence levels, discovery-field discipline, and command-run boundary discipline; it does not rerun external source trees or dynamic artifacts.",
  "claim_kind_domain": [
    "formal-source",
    "traceability",
    "route",
    "submission",
    "artifact",
    "discovery",
    "work-selection"
  ],
  "evidence_levels": [
    "path-verified",
    "command-run"
  ],
  "gate_dispatch": {
    "formal-source": [
      "build",
      "axiom-purity"
    ],
    "traceability": [
      "inventory",
      "marker-existence"
    ],
    "route": [
      "promotion",
      "overlap",
      "submission-state"
    ],
    "submission": [
      "submission-pack"
    ],
    "artifact": [
      "status",
      "limitation-ledger"
    ],
    "discovery": [
      "pinned-discovery",
      "theorem-content-delta"
    ],
    "work-selection": [
      "scheduler"
    ]
  },
  "record_required_fields": [
    "entry",
    "accepted_load_bearing_claim",
    "claim_kind_set",
    "evidence_level",
    "evidence_surface",
    "human_promotion",
    "pass_records",
    "discovery_interface",
    "boundary"
  ],
  "pass_record_required_fields": [
    "gate_name",
    "input_surface",
    "decision",
    "evidence_pointer",
    "evidence_level"
  ],
  "pass_decisions": [
    "pass",
    "bounded-pass",
    "rejected-stronger-claim"
  ],
  "manifest_required_files": {
    "certificate_schema": "review_bundle/certificate_schema.json",
    "current_package_pass_records": "review_bundle/current_package_pass_records.json",
    "submission_interface_map": "review_bundle/submission_interface_map.json",
    "primary_claim_inventory": "review_bundle/primary_claim_inventory.json",
    "theorem_inventory": "theorem_inventory.json",
    "verifier_script": "review_bundle/verify_certificate_records.py",
    "verifier_run_log": "review_bundle/certificate_verification_run.log",
    "theorem_environment_extractor": "review_bundle/extract_theorem_environments.py",
    "theorem_environment_extractor_run_log": "review_bundle/theorem_environment_extraction_run.log"
  },
  "local_check_rules": [
    "REVIEW_BUNDLE_MANIFEST.json contains every key in manifest_required_files and each value equals the listed bundle path",
    "claim_kind_set is a nonempty subset of claim_kind_domain",
    "evidence_level is one of evidence_levels",
    "evidence_surface is a nonempty finite list of strings",
    "for each gate assigned by gate_dispatch to the claim kinds, pass_records contains at least one record with the same gate_name",
    "each pass record contains gate_name, input_surface, decision, evidence_pointer, and evidence_level",
    "each pass record evidence_level equals the parent evidence_level",
    "each pass record evidence_pointer is contained in the parent evidence_surface or names a manifest/table/snapshot row present in the package boundary",
    "discovery_interface is present exactly when claim_kind_set contains discovery",
    "command-run evidence requires command, source_commit, environment, exit_code, and log_path under boundary.command_run_fields; path-verified evidence requires boundary.no_command_run_assertion"
  ],
  "accepted_artifact_patterns": [
    "submission_abstract.tex",
    "main.tex",
    "PIPELINE.md",
    "SOURCE_MAP.md",
    "ARTIFACT_INVENTORY.md",
    "source_interface_record.json",
    "review_bundle/REVIEW_BUNDLE_MANIFEST.json",
    "review_bundle/certificate_schema.json",
    "review_bundle/current_package_pass_records.json",
    "review_bundle/submission_interface_map.json",
    "review_bundle/primary_claim_inventory.json",
    "review_bundle/certificate_verification_run.log",
    "review_bundle/source_snapshots/*",
    "review_bundle/case_snapshots/*",
    "explicit-historical-boundary:*",
    "manifest:*",
    "table:*",
    "proposition:*",
    "lemma:*",
    "theorem:*",
    "corollary:*",
    "review_bundle/theorem_environment_extraction_run.log",
    "review_bundle/extract_theorem_environments.py",
    "theorem_inventory.json",
    "theorem_inventory.md"
  ]
}
