18: \title{An Auditable Theory Compiler for AI-Assisted Formal Mathematics\\
19: \large Technical Supplement: Finite-Record-Only Safety under Record-Gate Soundness}
20: \titlerunning{An Auditable Theory Compiler}
21: \author{Haobo Ma\inst{1} \and Wenlin Zhang\inst{2}}
22: \authorrunning{H. Ma and W. Zhang}
23: \institute{AELF PTE LTD. \email{auric@aelf.io} \and
24: National University of Singapore \email{e1327962@u.nus.edu}}
